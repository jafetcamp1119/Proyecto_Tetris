{
  "name": "tetris-app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "red:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ConfigurarRedLocal.ps1",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "medir:audio": "node scripts/MedirRecursosAudio.cjs",
    "red:publica": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ConfigurarPublicacion.ps1",
    "backend:publicado": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/IniciarBackendPublicado.ps1",
    "build:local": "ng build --configuration development",
    "verificar:publicacion": "node scripts/VerificarPublicacion.cjs",
    "recursos:iconos": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/recursos/PrepararIconos.ps1",
    "recursos:qr": "node scripts/recursos/PrepararQr.cjs",
    "recursos:presentacion": "npm run recursos:iconos && npm run recursos:qr",
    "test:presentacion": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/presentacion/PruebasPresentacion.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/presentacion/PruebasEstadoPresentacion.ps1 && npm run test:confirmacion && npm run test:salud && npm run test:cloudflare && node scripts/recursos/VerificarIconos.cjs && node scripts/recursos/PrepararQr.cjs && node scripts/PruebasPanel.cjs",
    "test:confirmacion": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/presentacion/PruebasConfirmacionPublicacion.ps1",
    "test:cloudflare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/presentacion/PruebasRegistrosCloudflare.ps1",
    "test:salud": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/presentacion/PruebasSalud.ps1"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-social-login": "8.7.5",
    "@ionic/angular": "^9.0.0",
    "@microsoft/signalr": "10.0.11",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "8.3.3",
    "xcode": { "uuid": "11.1.1" }
  },
  "description": "An Ionic project"
}
